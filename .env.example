# Copy to .env (gitignored) and adjust:  cp .env.example .env
# Read by docker compose (variable substitution) and by the backend (core/config.py).
# Local-only dummy values; never put real secrets in this file, it is committed.

# --- backend app ---
SERVICE_NAME=api
LOG_LEVEL=INFO
# json = one JSON object per line (like on AWS); console = coloured, human-readable
LOG_FORMAT=console

# --- auth ---
# Signs access tokens (HS256). Local dummy only; on AWS it comes from SSM Parameter Store (SecureString).
# Generate a real one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=local-dev-jwt-secret-change-me-0123456789abcdef

# --- payments (fakepay, the simulated provider) ---
# Shared secret for webhook signatures (HMAC). Both fakepay and the API read it. Local dummy only.
FAKEPAY_WEBHOOK_SECRET=whsec_local_dev_0123456789abcdef
# For the API running ON YOUR MACHINE (Compose sets container-internal values itself):
FAKEPAY_URL=http://localhost:8100
FAKEPAY_PUBLIC_URL=http://localhost:8100
WEBHOOK_BASE_URL=http://localhost:8000
PUBLIC_WEB_URL=http://localhost:5173

# --- Postgres container ---
POSTGRES_USER=eventpark
POSTGRES_PASSWORD=eventpark-local-only
POSTGRES_DB=eventpark
# Port on YOUR machine (localhost:5433). Inside Docker it is always 5432. 5433 avoids clashing with a
# Postgres installed directly on Windows/your host, which usually takes 5432.
POSTGRES_HOST_PORT=5433

# Used when you run the backend ON YOUR MACHINE (uv run ...): Compose publishes the ports on localhost.
# Containers on the Compose network use the service names instead (postgres:5432, valkey:6379);
# docker-compose.yml sets those for the api container itself.
DATABASE_URL=postgresql+asyncpg://eventpark:eventpark-local-only@localhost:5433/eventpark
REDIS_URL=redis://localhost:6379/0

# --- AWS emulators (local only) ---
# boto3 reads these standard variables by itself. On AWS the endpoint variables are simply not set, so boto3
# talks to the real services, and the credentials come from the ECS task role: same code, different config.
AWS_REGION=eu-central-1
AWS_DEFAULT_REGION=eu-central-1
# Dummy keys accepted by the emulators (docker/seaweedfs/s3.json). Not real AWS credentials.
AWS_ACCESS_KEY_ID=eventpark-local
AWS_SECRET_ACCESS_KEY=eventpark-local-secret
AWS_ENDPOINT_URL_S3=http://localhost:8333
AWS_ENDPOINT_URL_SQS=http://localhost:9324
# Address the *browser* uses for presigned S3 URLs (the signature includes the host).
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
BUCKET_FILES=eventpark-files
