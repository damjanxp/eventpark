# Copy to .env (gitignored) and adjust:  cp .env.example .env
# Read by docker compose (variable substitution) and by the backend (core/config.py).
# Local-only dummy values; never put real secrets in this file, it is committed.

# --- backend app ---
SERVICE_NAME=api
LOG_LEVEL=INFO
# json = one JSON object per line (like on AWS); console = coloured, human-readable
LOG_FORMAT=console

# --- Postgres container ---
POSTGRES_USER=eventpark
POSTGRES_PASSWORD=eventpark-local-only
POSTGRES_DB=eventpark
# Port on YOUR machine (localhost:5433). Inside Docker it is always 5432. 5433 avoids clashing with a
# Postgres installed directly on Windows/your host, which usually takes 5432.
POSTGRES_HOST_PORT=5433

# Used when you run the backend ON YOUR MACHINE (uv run ...): Compose publishes the ports on localhost.
# Containers on the Compose network use the service names instead (postgres:5432, valkey:6379);
# docker-compose.yml sets those for the api container itself.
DATABASE_URL=postgresql+asyncpg://eventpark:eventpark-local-only@localhost:5433/eventpark
REDIS_URL=redis://localhost:6379/0
